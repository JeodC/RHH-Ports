#!/bin/bash
# Set GAMEDIR to the current directory and set logfile
GAMEDIR="$PWD"
LOGFILE="patchlog.txt"
LOGERR="patcherr.txt"

# Redirect output and error to the log file
rm -f "$GAMEDIR/$LOGERR"
# Save the patcher's pipe (original stdout) on fd 3 before redirecting stdout
# through tee. This lets emit_fail_msg send dialog overrides straight to the
# patcher GUI without them appearing in patchlog.txt.
exec 3>&1
> "$GAMEDIR/$LOGFILE" && exec > >(tee "$GAMEDIR/$LOGFILE") 2>&1

emit_fail_msg() {
    echo "PATCH_FAIL_MSG:$1" >&3
    echo "$1"
    FAIL_MSG_SET=1
}

# Variables
TMPDIR="$GAMEDIR/tmp"
PATCH_VERSION_FILE="$GAMEDIR/.patch_version"
UPDATE_CHECK_FILE="$GAMEDIR/.update_check"
SEVENZIP="$controlfolder/7zzs.${DEVICE_ARCH}"
RELEASE_ZIP="${RELEASE_URL##*/}"

prepare_system() {
    if [ ! -x "$SEVENZIP" ]; then
        emit_fail_msg "7zzs is missing. Update PortMaster."
        return 1
    fi

    rm -rf "$TMPDIR"
    if [ "$(df -Pk "$GAMEDIR" | awk 'NR==2 {print $4}')" -lt $((100 * 1024)) ]; then
        emit_fail_msg "Not enough free space. 100 MB is needed."
        return 1
    fi
    mkdir -p "$TMPDIR"
}

download_release() {
    local tries url
    for tries in 1 2 3; do
        # The latest release's link redirects to its tag
        url=$(curl -fsS --max-time 30 -o /dev/null -w '%{redirect_url}' "$RELEASE_URL")
        [ -n "$url" ] || continue
        VERSION=$(basename "$(dirname "$url")")
        echo "Downloading PokéDaisy $VERSION..."
        curl -fsSL -C - --max-time 600 -o "$1" "$url" && return 0
    done
    return 1
}

# A zip in the port's folder is used when the download isn't available
get_release() {
    local zip="$TMPDIR/$RELEASE_ZIP"
    if ! download_release "$zip"; then
        zip="$GAMEDIR/$RELEASE_ZIP"
        VERSION="manual"
        if [ ! -f "$zip" ]; then
            emit_fail_msg "Download failed. Check your internet connection, or drop $RELEASE_ZIP into the pokedaisy folder for offline install."
            return 1
        fi
        echo "Using manually-placed $RELEASE_ZIP."
    fi

    "$SEVENZIP" x -y -o"$TMPDIR" "$zip" >/dev/null && PACKAGE=$(find "$TMPDIR" -type f -name pokedaisy-linux -exec dirname {} \;)
    if [ -z "$PACKAGE" ]; then
        emit_fail_msg "Could not extract $RELEASE_ZIP - the download may be incomplete."
        return 1
    fi
}

install_files() {
    # Keep this port's own files over the package's
    (cd "$PACKAGE" && rm -f README.md port.json gameinfo.xml ./*.png)
    rm -rf "$GAMEDIR/licenses"
    mv -f "$PACKAGE"/* "$GAMEDIR/"
}

# Cleanup function
cleanup() {
    rm -rf "$TMPDIR"
}

record_patch_version() {
    echo "$VERSION" > "$PATCH_VERSION_FILE"
    echo "Recorded patch version: $VERSION"
}

record_update_preference() {
    if [ -n "$UPDATE_CHECK" ]; then
        echo "$UPDATE_CHECK" > "$UPDATE_CHECK_FILE"
        echo "Recorded update-check preference: $UPDATE_CHECK"
    fi
}

process_game() {
    echo "Preparing system..."
    prepare_system || return 1
    echo "Getting PokéDaisy..."
    get_release || return 1
    echo "Finishing up..."
    install_files || return 1
    record_patch_version
    record_update_preference
}

# Call the function
if ! process_game; then
    [ -z "$FAIL_MSG_SET" ] && emit_fail_msg "Installing failed. Report on the RHH-Ports GitHub with patcherr.txt."
    echo "Patching process failed!"
    mv "$LOGFILE" "$LOGERR"
else
    echo "Patching process complete!"
fi

# Always run cleanup at the end
cleanup
