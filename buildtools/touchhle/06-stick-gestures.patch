+    /// Drive the `--stick-to-pan=` drag and the `--triggers-to-pinch=` pinch.
+    /// Only one runs at a time, and neither starts while the virtual cursor is
+    /// held, since the app would take the extra fingers as a gesture.
+    fn update_stick_gestures(
+        &mut self,
+        options: &Options,
+        transform: fn(&Window, Coords, bool) -> Coords,
+    ) {
+        if options.stick_to_pan.is_none()
+            && options.edge_scroll.is_none()
+            && options.triggers_to_pinch.is_none()
+        {
+            return;
+        }
+
+        let now = Instant::now();
+        let dt = self.gesture_last_time.map_or(0.0, |last| {
+            now.saturating_duration_since(last).as_secs_f32().min(0.05)
+        });
+        self.gesture_last_time = Some(now);
+
+        let (vx, vy, vw, vh) = self.viewport();
+        let (vx, vy, vw, vh) = (vx as f32, vy as f32, vw as f32, vh as f32);
+        let (cx, cy) = (vx + vw / 2.0, vy + vh / 2.0);
+        let cursor_held = matches!(self.virtual_cursor_last, Some((_, _, true, _)))
+            || !matches!(self.cursor_drag, CursorDrag::Up);
+
+        let push = |window: &mut Window,
+                    kind: fn(HashMap<FingerId, Coords>) -> Event,
+                    fingers: &[(FingerId, Coords)]| {
+            let map = fingers
+                .iter()
+                .map(|&(finger, coords)| (finger, transform(&*window, coords, false)))
+                .collect();
+            window.event_queue.push_back(kind(map));
+        };
+
+        if options.stick_to_pan.is_some() || options.edge_scroll.is_some() {
+            // Screen widths per second, from the stick and the edge push.
+            let (mut sx, mut sy) = (0.0, 0.0);
+            if let Some(speed) = options.stick_to_pan {
+                let (x, y, _) =
+                    self.get_controller_stick(options, !options.virtual_cursor_left_stick);
+                (sx, sy) = (x * x.abs() * speed, y * y.abs() * speed);
+            }
+            if let Some(speed) = options.edge_scroll {
+                let (x, y) = self.edge_push;
+                (sx, sy) = (sx + x * x.abs() * speed, sy + y * y.abs() * speed);
+            }
+            let active =
+                (sx != 0.0 || sy != 0.0) && !cursor_held && self.pinch_half_width.is_none();
+            // The finger moves against the scroll: dragging the world left
+            // moves the view right.
+            match (self.pan_touch, active) {
+                (None, true) => {
+                    // Nudge straight away so the app sees a drag, not a tap.
+                    let kick = 0.04 * vw / sx.hypot(sy);
+                    let to = (cx - sx * kick, cy - sy * kick);
+                    push(self, Event::TouchesDown, &[(FingerId::StickToPan, (cx, cy))]);
+                    push(self, Event::TouchesMove, &[(FingerId::StickToPan, to)]);
+                    self.pan_touch = Some(to);
+                }
+                (Some((x, y)), true) => {
+                    let step = vw * dt;
+                    let to = (x - sx * step, y - sy * step);
+                    if (to.0 - cx).abs() > 0.4 * vw || (to.1 - cy).abs() > 0.4 * vh {
+                        // Out of room: lift and start again from the center.
+                        push(self, Event::TouchesUp, &[(FingerId::StickToPan, (x, y))]);
+                        self.pan_touch = None;
+                    } else {
+                        push(self, Event::TouchesMove, &[(FingerId::StickToPan, to)]);
+                        self.pan_touch = Some(to);
+                    }
+                }
+                (Some(at), false) => {
+                    push(self, Event::TouchesUp, &[(FingerId::StickToPan, at)]);
+                    self.pan_touch = None;
+                }
+                (None, false) => (),
+            }
+        }
+
+        if let Some(speed) = options.triggers_to_pinch {
+            use sdl2::controller::Axis;
+            let trigger = |axis: Axis| {
+                self.controllers
+                    .iter()
+                    .map(|c| (c.axis(axis) as f32 / i16::MAX as f32).clamp(0.0, 1.0))
+                    .fold(0.0, f32::max)
+            };
+            let mut spread = trigger(Axis::TriggerRight) - trigger(Axis::TriggerLeft);
+            if spread.abs() < options.deadzone {
+                spread = 0.0;
+            }
+            let active = spread != 0.0 && !cursor_held && self.pan_touch.is_none();
+            let fingers = |half: f32| {
+                [
+                    (FingerId::TriggerPinch(0), (cx - half, cy)),
+                    (FingerId::TriggerPinch(1), (cx + half, cy)),
+                ]
+            };
+            match (self.pinch_half_width, active) {
+                (None, true) => {
+                    // Open from close together, close from far apart.
+                    let half = vw * if spread > 0.0 { 0.08 } else { 0.35 };
+                    push(self, Event::TouchesDown, &fingers(half));
+                    self.pinch_half_width = Some(half);
+                }
+                (Some(half), true) => {
+                    let to = half + spread * speed * vw * dt;
+                    if !(0.04 * vw..=0.45 * vw).contains(&to) {
+                        push(self, Event::TouchesUp, &fingers(half));
+                        self.pinch_half_width = None;
+                    } else {
+                        push(self, Event::TouchesMove, &fingers(to));
+                        self.pinch_half_width = Some(to);
+                    }
+                }
+                (Some(half), false) => {
+                    push(self, Event::TouchesUp, &fingers(half));
+                    self.pinch_half_width = None;
+                }
+                (None, false) => (),
+            }
+        }
+    }
