             log_dbg!("New view frame after re-applying old view frame: {view_frame:?}");
         }
+        if callbacks {
+            () = msg![env; vc didRotateFromInterfaceOrientation:UIInterfaceOrientationPortrait];
+        }
     }
 }
 
