         gles.Enable(gles11::BLEND);
         gles.BlendFunc(gles11::ONE, gles11::ONE_MINUS_SRC_ALPHA);
+
+        if let Some([r, g, b]) = arrow {
+            // A pointer with its tip on the cursor, as triangles, one unit tall.
+            const ARROW: [(f32, f32); 15] = [
+                (0.0, 0.0), (0.0, 0.8), (0.22, 0.62),
+                (0.0, 0.0), (0.22, 0.62), (0.34, 0.58),
+                (0.0, 0.0), (0.34, 0.58), (0.6, 0.58),
+                (0.22, 0.62), (0.36, 0.95), (0.48, 0.9),
+                (0.22, 0.62), (0.48, 0.9), (0.34, 0.58),
+            ];
+            let size = (vh as f32 / 40.0).max(14.0);
+            let outline = (size / 14.0).max(1.0);
+            let mut draw = |(dx, dy): (f32, f32), [r, g, b]: [f32; 3]| {
+                let mut vertices = [0.0f32; ARROW.len() * 2];
+                for (i, &(px, py)) in ARROW.iter().enumerate() {
+                    vertices[i * 2] = (x + dx + px * size) / (vw as f32 / 2.0) - 1.0;
+                    vertices[i * 2 + 1] = 1.0 - (y + dy + py * size) / (vh as f32 / 2.0);
+                }
+                gles.Color4f(r, g, b, 1.0);
+                gles.VertexPointer(2, gles11::FLOAT, 0, vertices.as_ptr() as *const GLvoid);
+                gles.DrawArrays(gles11::TRIANGLES, 0, ARROW.len() as _);
+            };
+            // The outline is the shape drawn dark, nudged every way around.
+            for dx in [-outline, 0.0, outline] {
+                for dy in [-outline, 0.0, outline] {
+                    draw((dx, dy), [0.0, 0.0, 0.0]);
+                }
+            }
+            // Lighter while pressed.
+            let lift = |c: f32| if pressed { c + (1.0 - c) * 0.35 } else { c };
+            draw((0.0, 0.0), [lift(r), lift(g), lift(b)]);
+            return;
+        }
+
         gles.Color4f(0.0, 0.0, 0.0, if pressed { 2.0 / 3.0 } else { 1.0 / 3.0 });
 
         let radius = 10.0;
