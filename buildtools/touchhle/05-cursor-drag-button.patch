+/// The `--cursor-drag-button=` finger, where a press waits to see whether it
+/// is a tap or a drag. Positions are on-screen.
+#[derive(Clone, Copy)]
+enum CursorDrag {
+    Up,
+    /// Pressed here, not sent yet.
+    Pending(Coords),
+    /// Tapping the drag-tap point before dragging from here. The bool is
+    /// whether the tap has lifted.
+    DragTap(Coords, Instant, bool),
+    Down,
+    /// Sent and released at once; lifted on a later poll so the app sees both.
+    /// The bool is whether the position ignores the viewport.
+    Lifting(FingerId, Coords, bool, Instant),
+}
