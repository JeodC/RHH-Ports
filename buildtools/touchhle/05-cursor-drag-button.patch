+    /// Drive the `--cursor-drag-button=` finger. A press is held back until
+    /// the cursor moves, which taps the `--cursor-drag-tap=` point (e.g. a
+    /// drag-select button) and then drags from where the press began.
+    /// Released without moving, it does the button's `--button-to-touch=` tap.
+    fn update_cursor_drag(
+        &mut self,
+        options: &Options,
+        at: Coords,
+        moved: bool,
+        transform: fn(&Window, Coords, bool) -> Coords,
+    ) {
+        // Gap between touch events the app must see separately.
+        const STEP: Duration = Duration::from_millis(50);
+        // In app pixels.
+        const DRAG_DISTANCE: f32 = 8.0;
+
+        let Some(button) = options.cursor_drag_button else {
+            return;
+        };
+        let pressed = {
+            let button = sdl_button(button);
+            self.controllers.iter().any(|c| c.button(button))
+        };
+        let send = |window: &mut Window,
+                    kind: fn(HashMap<FingerId, Coords>) -> Event,
+                    finger: FingerId,
+                    coords: Coords,
+                    independent_of_viewport: bool| {
+            let coords = transform(&*window, coords, independent_of_viewport);
+            window.event_queue.push_back(kind(HashMap::from([(finger, coords)])));
+        };
+        let now = Instant::now();
+        let drag = FingerId::CursorDrag;
+        let tap = FingerId::CursorDragTap;
+
+        self.cursor_drag = match self.cursor_drag {
+            CursorDrag::Up if pressed => CursorDrag::Pending(at),
+            CursorDrag::Pending(_) if !pressed => {
+                match options.button_to_touch.get(&button) {
+                    Some(&point) => {
+                        let finger = FingerId::ButtonToTouch(button);
+                        send(self, Event::TouchesDown, finger, point, true);
+                        CursorDrag::Lifting(finger, point, true, now)
+                    }
+                    None => CursorDrag::Up,
+                }
+            }
+            CursorDrag::Pending(start) => {
+                let (sx, sy) = transform(self, start, false);
+                let (x, y) = transform(self, at, false);
+                if (x - sx).hypot(y - sy) <= DRAG_DISTANCE {
+                    CursorDrag::Pending(start)
+                } else if let Some(point) = options.cursor_drag_tap {
+                    send(self, Event::TouchesDown, tap, point, true);
+                    CursorDrag::DragTap(start, now, false)
+                } else {
+                    send(self, Event::TouchesDown, drag, start, false);
+                    send(self, Event::TouchesMove, drag, at, false);
+                    CursorDrag::Down
+                }
+            }
+            CursorDrag::DragTap(start, since, false) if now - since >= STEP => {
+                send(self, Event::TouchesUp, tap, options.cursor_drag_tap.unwrap(), true);
+                CursorDrag::DragTap(start, now, true)
+            }
+            CursorDrag::DragTap(start, since, true) if now - since >= STEP => {
+                send(self, Event::TouchesDown, drag, start, false);
+                send(self, Event::TouchesMove, drag, at, false);
+                if pressed {
+                    CursorDrag::Down
+                } else {
+                    CursorDrag::Lifting(drag, at, false, now)
+                }
+            }
+            CursorDrag::Down if !pressed => {
+                send(self, Event::TouchesUp, drag, at, false);
+                CursorDrag::Up
+            }
+            CursorDrag::Down if moved => {
+                send(self, Event::TouchesMove, drag, at, false);
+                CursorDrag::Down
+            }
+            CursorDrag::Lifting(finger, point, independent, since) if now - since >= STEP => {
+                send(self, Event::TouchesUp, finger, point, independent);
+                CursorDrag::Up
+            }
+            state => state,
+        };
+    }
